### Variables
@baseUrl = http://localhost:8080
@renderUrl = https://cse-341-project-1.onrender.com

# Fallback contact ID for manual testing (replace with an ID from your database if needed)
@contactId = 6aaf174f524c726a1d994c4a


############################################################
# LOCALHOST TESTS
############################################################

### 1. GET all contacts
GET {{baseUrl}}/contacts HTTP/1.1

### 2. POST create a new contact (Success - all fields required)
# @name createContact
POST {{baseUrl}}/contacts HTTP/1.1
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Doe",
  "email": "johndoe@example.com",
  "favoriteColor": "Blue",
  "birthday": "1990-05-15"
}

### Capture created ID from response (REST Client variable)
@createdId = {{createContact.response.body.id}}

### 3. POST test validation failure (Missing required field: favoriteColor)
POST {{baseUrl}}/contacts HTTP/1.1
Content-Type: application/json

{
  "firstName": "Incomplete",
  "lastName": "User",
  "email": "incomplete@example.com",
  "birthday": "1995-01-01"
}

### 4. POST test validation failure (Empty / blank string field)
POST {{baseUrl}}/contacts HTTP/1.1
Content-Type: application/json

{
  "firstName": "   ",
  "lastName": "Blank",
  "email": "blank@example.com",
  "favoriteColor": "Yellow",
  "birthday": "1993-04-10"
}

### 5. GET single contact by ID (Using ID from POST createContact)
GET {{baseUrl}}/contacts/{{createdId}} HTTP/1.1

### 6. GET single contact with invalid ID format (Returns 400)
GET {{baseUrl}}/contacts/invalid-id HTTP/1.1

### 7. PUT update contact (Success - all fields required)
PUT {{baseUrl}}/contacts/{{createdId}} HTTP/1.1
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Updated",
  "email": "johnupdated@example.com",
  "favoriteColor": "Navy Blue",
  "birthday": "1990-05-15"
}

### 8. Verify update via GET
GET {{baseUrl}}/contacts/{{createdId}} HTTP/1.1

### 9. PUT update contact validation failure (Missing required field)
PUT {{baseUrl}}/contacts/{{createdId}} HTTP/1.1
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Updated"
}

### 10. PUT update contact with invalid ID format (Returns 400)
PUT {{baseUrl}}/contacts/invalid-id HTTP/1.1
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Updated",
  "email": "johnupdated@example.com",
  "favoriteColor": "Navy Blue",
  "birthday": "1990-05-15"
}

### 11. DELETE contact (Returns 200 HTTP status)
DELETE {{baseUrl}}/contacts/{{createdId}} HTTP/1.1

### 12. Verify deletion via GET (Should return 404 Not Found)
GET {{baseUrl}}/contacts/{{createdId}} HTTP/1.1

### 13. DELETE non-existent contact (Should return 404 Not Found)
DELETE {{baseUrl}}/contacts/{{createdId}} HTTP/1.1

### 14. DELETE with invalid ID format (Returns 400)
DELETE {{baseUrl}}/contacts/invalid-id HTTP/1.1


