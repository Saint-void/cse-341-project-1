### Variables
@baseUrl = http://localhost:8080
@contactId = 66e8b2f9024f22f7b8849b3a

# Change @renderUrl to your deployed Render URL if testing production
@renderUrl = https://your-render-service.onrender.com


############################################################
# LOCALHOST TESTS
############################################################

### 1. GET all contacts
GET {{baseUrl}}/contacts HTTP/1.1

### 2. POST create a new contact (Success - all fields required)
# @name createContact
POST {{baseUrl}}/contacts HTTP/1.1
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Doe",
  "email": "johndoe@example.com",
  "favoriteColor": "Blue",
  "birthday": "1990-05-15"
}

### 3. POST create another contact
POST {{baseUrl}}/contacts HTTP/1.1
Content-Type: application/json

{
  "firstName": "Jane",
  "lastName": "Smith",
  "email": "janesmith@example.com",
  "favoriteColor": "Green",
