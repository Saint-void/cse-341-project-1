  "birthday": "1995-01-01"
}

### 5. GET single contact by ID (Replace ID with actual ID from POST response)
GET {{baseUrl}}/contacts/{{contactId}} HTTP/1.1

### 6. PUT update a contact (Replace ID with actual ID)
PUT {{baseUrl}}/contacts/{{contactId}} HTTP/1.1
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Updated",
  "email": "johnupdated@example.com",
  "favoriteColor": "Navy Blue",
  "birthday": "1990-05-15"
}

### 7. DELETE a contact (Replace ID with actual ID)
DELETE {{baseUrl}}/contacts/{{contactId}} HTTP/1.1

### 8. Verify deletion (Should return 404 Not Found)
GET {{baseUrl}}/contacts/{{contactId}} HTTP/1.1


