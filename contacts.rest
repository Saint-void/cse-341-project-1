# @name createContactRender
POST {{renderUrl}}/contacts HTTP/1.1
Content-Type: application/json

{
  "firstName": "Render",
  "lastName": "Test",
  "email": "render@example.com",
  "favoriteColor": "Purple",
  "birthday": "2000-01-01"
}

